#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE   0
#define MODE1  1
#define MODE2  2
#define MODE3  3

/ {

    macros {
        bcl: battery_central {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&none>;  /* placeholder — no C_BATTERY in ZMK */
        };

        bpl: battery_peripheral {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&none>;
        };
};

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5            &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T             &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSPC
&kp LSHFT  &kp A     &kp S     &kp D     &kp F     &kp G             &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z     &kp X     &kp C     &kp V     &kp B             &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RCTRL
&kp LGUI   &kp LALT  &mo MODE1 &kp SPACE &kp DEL   &kp C_MUTE        &kp C_PP   &kp ENTER &kp SPACE  &mo MODE2 &mo MODE3 &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        mode1_layer {
            display-name = "Mode 1";
            bindings = <
&kp F11       &kp F1  &kp F2    &kp F3    &kp F4    &kp F5          &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans        &trans  &trans    &trans    &trans    &kp HOME        &kp END   &trans  &trans  &trans  &trans   &trans
&trans        &trans  &kp LEFT  &kp UP    &kp RIGHT &trans          &trans    &trans  &trans  &trans  &trans   &trans
&trans        &trans  &trans    &kp DOWN  &kp C_PREV &kp C_NEXT     &trans    &trans  &trans  &trans  &trans   &trans
&kp C_VOL_DN  &trans  &trans    &trans    &trans    &trans          &trans    &trans  &trans  &trans  &trans   &kp C_VOL_UP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        mode2_layer {
            display-name = "Mode 2";
            bindings = <
&kp F11       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp F6    &kp F7  &kp F8  &kp F9  &kp F10   &kp F12
&trans        &trans  &trans  &trans  &trans  &kp HOME      &kp END   &kp N7  &kp N8  &kp N9  &kp N0    &trans
&trans        &trans  &trans  &trans  &trans  &kp LBKT      &kp RBKT  &kp N4  &kp N5  &kp N6  &kp PLUS  &kp STAR
&trans        &trans  &trans  &trans  &trans  &kp LPAR      &kp RPAR  &kp N1  &kp N2  &kp N3  &kp MINUS &kp FSLH
&kp C_VOL_DN  &trans  &trans  &trans  &trans  &trans        &trans    &trans  &trans  &trans  &trans    &kp C_VOL_UP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        mode3_layer {
            display-name = "Mode 3";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bcl     &bpl       &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };
    };
};