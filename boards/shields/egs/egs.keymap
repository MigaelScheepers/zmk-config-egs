#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Define clean layer alias shortcuts */
#define DEFAULT 0
#define MODE1   1
#define MODE2   2
#define MODE3   3

/ {
    /* Map your physical rotary turns to actions */
    sensor_bindings: sensor_bindings {
        compatible = "zmk,keymap-sensor-bindings";
    };

    keymap {
        compatible = "zmk,keymap";

        /* ==========================================================================
         * LAYER 0: DEFAULT BASE LAYER
         * ========================================================================== */
        default_layer {
            display-name = "Base";
            bindings = <
    /* Row 0 */
    &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
    /* Row 1 */
    &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I     &kp O    &kp P    &kp BSPC
    /* Row 2 */
    &kp LSHFT  &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K     &kp L    &kp SEMI &kp SQT
    /* Row 3 */
    &kp LCTRL  &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RCTRL
    /* Row 4 */
    &kp LALT   &kp LGUI &mo MODE1 &kp SPACE &kp DEL &kp C_MUTE   &kp C_PP &kp ENTER &kp SPACE &mo MODE2 &mo MODE3 &kp RALT
            >;

            /* Left Side Encoder = Volume Control | Right Side Encoder = Media Track Skip */
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        /* ==========================================================================
         * LAYER 1: MODE 1 (Hold to activate)
         * ========================================================================== */
        mode1_layer {
            display-name = "Mode 1";
            bindings = <
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
            >;

            sensor-bindings = <&trans &trans>;
        };

        /* ==========================================================================
         * LAYER 2: MODE 2 (Hold to activate)
         * ========================================================================== */
        mode2_layer {
            display-name = "Mode 2";
            bindings = <
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
    &trans     &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans    &trans   &trans   &trans
            >;

            sensor-bindings = <&trans &trans>;
        };

        /* ==========================================================================
         * LAYER 3: MODE 3 (Hold to activate / Wireless Profiles Setup)
         * ========================================================================== */
        mode3_layer {
            display-name = "Mode 3";
            bindings = <
    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans     &trans       &trans       &trans       &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans     &trans       &trans       &trans       &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans     &trans       &trans       &trans       &trans &trans   &trans &trans &trans &trans &trans &trans
    &trans     &trans       &trans       &trans       &trans &trans   &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&trans &trans>;
        };
    };
};