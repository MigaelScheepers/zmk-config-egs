/*
 * Copyright (c) 2026 The EGS_W1 Project Contributor
 * SPDX-License-Identifier: MIT
 *
 * EGS_W1  —  5 rows × 12 logical columns (6 left + 6 right)
 *
 * Left MCU:  logical cols  0..5  map to physical cols 0..5  (Col0=outermost)
 * Right MCU: logical cols  6..11 map to physical cols 0..5  (Col0=outermost/rightmost)
 *            so RC(r,6) = right Col0 (rightmost key), RC(r,11) = right Col5 (inner key)
 *
 * Physical layout (Row0 example):
 *   Left:  Esc(0,0) 1(0,1) 2(0,2) 3(0,3) 4(0,4) 5(0,5)  |  6(0,6) 7(0,7) 8(0,8) 9(0,9) 0(0,10) -(0,11)
 *
 * Right side columns are mirrored in hardware, so the transform below
 * reverses them: RC(r,6)..RC(r,11) reads right-MCU cols 5..0 respectively.
 *   RC(0,6)  = right physical Col5 (innermost)  = key "6"
 *   RC(0,11) = right physical Col0 (outermost)  = key "-"
 */

/ {
    layouts {
        compatible = "zmk,physical-layouts";

        default_layout: egs_layout {
            compatible = "zmk,physical-layout";
            display-name = "EGS Default Layout";
            transform = <&matrix_transform>;
        };
    };

    matrix_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <12>;

        map = <
           RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)              RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
           RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)              RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
           RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(4,5)             RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
           RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(4,4)             RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                 RC(4,0) RC(4,1) RC(4,2) RC(4,3)      RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };
};
